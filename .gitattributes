/bench/** export-ignore
/desks/** export-ignore
/docs/** export-ignore

# A stale full copy of the add-on with its own TacoTip.toc, kept in-repo but
# never packaged.
/OLD/** export-ignore

# In-game WoWUnit suite and the release verifier itself.
/Tests/** export-ignore
/Tools/** export-ignore

# The Extras companion is its own CurseForge project, shipped as its own
# package; a TacoTip archive must not contain a second .toc. The Extras
# package's own rules live in `TacoTip_Extras/.gitattributes`; the two are
# read in different scopes (a TacoTip archive is built from the repository
# root, an Extras archive from the subtree), so they do not fight.
/TacoTip_Extras/** export-ignore

# Library `.toc` metadata. TacoTip.toc loads every library by explicit path,
# so these would be extra .toc files with nothing to load.
/Libs/LibDetours-1.0/LibDetours-1.0.toc export-ignore
/Libs/LibStub/LibStub.toc export-ignore

