# SwedgeTimer packaging attributes.
# The addon ships as ONE universal build: the seven TOCs are the only per-flavor
# artifacts, and every Lua module is shared. This file controls what a git-archive
# release contains; it must never remove payload the TOCs reference.

* text=auto eol=lf

# Workshop / audit / development trees (not addon payload).
/bench/** export-ignore
/desks/** export-ignore
/docs/** export-ignore
/tests/** export-ignore
/OLD/** export-ignore
/Tests/** export-ignore
/Tools/** export-ignore

# Role documents and tooling state.
/AGENTS.md export-ignore
/CAIRN.md export-ignore
/hands-up.md export-ignore
/MEMORY.md export-ignore
/workshop.md export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.luacheckrc export-ignore
/.luarc.json export-ignore
/.wowluarc.json export-ignore
/.vscode/** export-ignore
/.omg/** export-ignore
/.serena/** export-ignore
/.ruff_cache/** export-ignore
/.dsh-progress/** export-ignore
/README.md export-ignore
/CHANGELOG.md export-ignore
/TESTING.md export-ignore
/LICENSE export-ignore

# Build / scratch artifacts (luac writes luac.out without -o).
/luac.out export-ignore

# Project-page art, not addon payload. The ## IconTexture file is the transparent
# TGA at the repo root and stays.
/*.png export-ignore
/Logo.tga export-ignore
/Logo.png export-ignore

# Unreferenced media. The shipped payload keeps:
#   Media/Fonts/**            (Expressway.ttf)
#   Media/Textures/**         (Minimalist.tga, circle_smooth.tga)
#   Media/StatusBar/Wglass.tga
#   Media/Sounds/**           (the paladin twist sounds)
# Class_icons, blizz_textures, Background, Details and Platynator are referenced by
# no Lua or TOC in the shipped tree (see bench/release_readiness_2026-10-20.md §3.3).
/Media/Class_icons/** export-ignore
/Media/blizz_textures/** export-ignore
/Media/Background/** export-ignore
/Media/Details/** export-ignore
/Media/Platynator/** export-ignore
